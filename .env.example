# Copy to .env and fill in values (never commit .env)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=JodongBroOfficial
SYNC_MAX_VIDEOS=20
SYNC_MAX_BLOG=10
PUBLIC_SITE_URL=https://jodong-content-hub.vercel.app

# 아지트 (짧은 글 / 마일스톤)
# Vercel에서 Neon 데이터베이스를 연결하면 자동으로 들어옵니다.
DATABASE_URL=
# Google Cloud에서 만든 로그인용 키
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 글쓰기를 허용할 내 구글 이메일
ADMIN_EMAIL=
# 아무 긴 랜덤 문자열 (로그인 출입증 도장용). 예: openssl rand -hex 32
AUTH_SECRET=
