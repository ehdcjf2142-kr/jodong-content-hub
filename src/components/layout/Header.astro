---
import ThemeToggle from './ThemeToggle';

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About' },
	{ href: '/archive/', label: 'Archive' },
	{ href: '/notes/', label: '아지트' },
	{ href: '/log/', label: 'Log' },
];
---

<header
	class="sticky top-0 z-50 border-b border-zinc-200/80 bg-zinc-50/85 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/85"
>
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
		<a href="/" class="group flex shrink-0 flex-col leading-tight">
			<span class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">조동이형</span>
			<span class="text-[11px] font-medium uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400"
				>Content Hub</span
			>
		</a>
		<nav class="hidden items-center gap-1 sm:flex" aria-label="주요 메뉴">
			{
				nav.map(({ href, label }) => (
					<a
						href={href}
						class="rounded-md px-3 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-200/70 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800/70 dark:hover:text-zinc-100"
					>
						{label}
					</a>
				))
			}
		</nav>
		<div class="flex min-w-0 items-center gap-2">
			<nav
				class="-mx-1 flex max-w-[55vw] items-center gap-0.5 overflow-x-auto px-1 sm:hidden"
				aria-label="주요 메뉴 모바일"
			>
				{
					nav.map(({ href, label }) => (
						<a
							href={href}
							class="shrink-0 rounded-md px-2 py-1.5 text-xs font-medium whitespace-nowrap text-zinc-600 hover:bg-zinc-200/70 dark:text-zinc-400 dark:hover:bg-zinc-800/70"
						>
							{label}
						</a>
					))
				}
			</nav>
			<ThemeToggle client:load />
		</div>
	</div>
</header>
