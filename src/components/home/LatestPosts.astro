---
import type { FeedItem } from '../../lib/types';
import SectionHeading from './SectionHeading.astro';
import BlogLinkCard from '../blog/BlogLinkCard.astro';

interface Props {
	items: FeedItem[];
}

const { items } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20">
	<SectionHeading
		title="최신 글"
		subtitle="티스토리와 네이버에서 새로 올라온 글 여섯 편을 날짜순으로 모았습니다."
	/>
	<ul class="space-y-4">
		{
			items.map((item) => (
				<li>
					<BlogLinkCard
						title={item.title}
						url={item.url}
						publishedAt={item.publishedAt}
						tags={item.tags}
						platform={item.platform === 'naver' ? 'naver' : 'tistory'}
						summary={item.summary}
					/>
				</li>
			))
		}
	</ul>
</section>
