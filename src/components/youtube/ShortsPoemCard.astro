---
import { formatDate } from '../../lib/format';

interface Props {
	title: string;
	url: string;
	thumbnailUrl?: string;
	publishedAt: Date;
}

const { title, url, thumbnailUrl, publishedAt } = Astro.props;
---

<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-200/80 bg-gradient-to-b from-white to-zinc-50/80 shadow-sm ring-1 ring-transparent transition hover:-translate-y-1 hover:scale-[1.01] hover:border-violet-200/90 hover:shadow-lg hover:ring-violet-300/25 dark:border-zinc-800/80 dark:from-zinc-950 dark:to-zinc-900/80 dark:hover:border-violet-500/30 dark:hover:ring-violet-500/20"
>
	<div class="relative aspect-[9/16] max-h-80 w-full overflow-hidden bg-zinc-900/5 dark:bg-zinc-800">
		{
			thumbnailUrl ? (
				<img
					src={thumbnailUrl}
					alt=""
					class="h-full w-full object-cover opacity-95 transition duration-500 group-hover:scale-[1.04] group-hover:opacity-100"
					loading="lazy"
					decoding="async"
				/>
			) : (
				<div class="flex h-full items-center justify-center text-xs text-zinc-500">Shorts</div>
			)
		}
		<div
			class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/55 to-transparent"
			aria-hidden="true"
		>
		</div>
	</div>
	<div class="flex flex-1 flex-col gap-2 p-4">
		<p class="text-[11px] font-medium tracking-widest text-violet-700 uppercase dark:text-violet-300">Visual Poem</p>
		<h3 class="font-serif text-lg leading-snug font-medium text-zinc-900 dark:text-zinc-50">{title}</h3>
		<p class="text-xs text-zinc-500 dark:text-zinc-500">{formatDate(publishedAt)}</p>
	</div>
</a>
