---
const links = [
	{ href: '#game-analysis', label: 'Game Analysis' },
	{ href: '#mobile-review', label: 'Mobile Review' },
	{ href: '#visual-poem', label: 'Visual Poem' },
];
---

<nav
	class="flex flex-wrap gap-2 rounded-xl border border-zinc-200/80 bg-white/70 p-3 text-sm dark:border-zinc-800/80 dark:bg-zinc-900/50"
	aria-label="YouTube 섹션 바로가기"
>
	{
		links.map(({ href, label }) => (
			<a
				href={href}
				class="rounded-lg bg-zinc-100 px-3 py-1.5 font-medium text-zinc-800 transition hover:bg-violet-100 hover:text-violet-900 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-violet-950/60 dark:hover:text-violet-100"
			>
				{label}
			</a>
		))
	}
</nav>
