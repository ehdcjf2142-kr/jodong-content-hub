---
import { formatDate } from '../../lib/format';

interface Props {
	title: string;
	url: string;
	publishedAt: Date;
	tags: string[];
	summary?: string;
}

const { title, url, publishedAt, tags, summary } = Astro.props;
---

<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	class="group flex flex-col rounded-2xl border border-zinc-200/90 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-violet-300/80 hover:shadow-md dark:border-zinc-800/90 dark:bg-zinc-900/40 dark:hover:border-violet-500/40"
>
	<div class="flex justify-end">
		<span class="text-xs text-zinc-500 dark:text-zinc-500">{formatDate(publishedAt)}</span>
	</div>
	<h3 class="mt-3 text-base font-semibold leading-snug text-zinc-900 dark:text-zinc-50">{title}</h3>
	{summary && <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{summary}</p>}
	{
		tags.length > 0 && (
			<ul class="mt-4 flex flex-wrap gap-1.5">
				{tags.map((t) => (
					<li class="rounded-md bg-zinc-100 px-2 py-0.5 text-[11px] font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
						{t}
					</li>
				))}
			</ul>
		)
	}
</a>
