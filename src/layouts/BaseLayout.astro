---
import '../styles/global.css';
import '@fontsource-variable/noto-sans-kr/index.css';
import '@fontsource-variable/noto-serif-kr/index.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = '조동이형 — 기록소',
	description = '게임으로 인생을 깨닫고 싶은 조동이의 온갖 삽질과 사유의 기록소',
	noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(function () {
				const key = 'theme';
				const stored = localStorage.getItem(key);
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const dark = stored === 'dark' || (!stored && prefersDark);
				document.documentElement.classList.toggle('dark', dark);
			})();
		</script>
	</head>
	<body
		class="min-h-dvh bg-zinc-50 text-zinc-900 antialiased transition-colors selection:bg-violet-200/80 selection:text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100 dark:selection:bg-violet-500/30 dark:selection:text-zinc-50"
	>
		<SkipLink />
		<div class="flex min-h-dvh flex-col">
			<Header />
			<main id="main" class="flex-1">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>
