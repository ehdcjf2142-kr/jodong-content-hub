---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LatestVideos from '../components/home/LatestVideos.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import { getAllFeedItems, takeLatest } from '../lib/content';

const feed = await getAllFeedItems();
const latestVideos = takeLatest(
	feed.filter((item) => item.kind === 'youtube'),
	6,
);
const latestPosts = takeLatest(
	feed.filter((item) => item.kind === 'blog'),
	6,
);
---

<BaseLayout
	title="조동이형 — 기록소"
	description="게임으로 인생을 깨닫고 싶은 조동이의 온갖 삽질과 사유의 기록소"
>
	<Hero />
	<LatestVideos items={latestVideos} />
	<LatestPosts items={latestPosts} />
</BaseLayout>
