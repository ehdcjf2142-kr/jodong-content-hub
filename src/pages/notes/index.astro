---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/home/SectionHeading.astro';
import { formatDateTime } from '../../lib/format';
import { listNotes, type Note } from '../../lib/notes';

export const prerender = false;

const isAdmin = Astro.locals.isAdmin;

let notes: Note[] = [];
try {
	notes = await listNotes(isAdmin);
} catch (e) {
	console.error('짧은 글을 불러오지 못했습니다.', e);
}
---

<BaseLayout title="아지트 — 조동이형" description="조동이의 짧은 생각과 푸념을 남기는 곳.">
	<div class="mx-auto max-w-2xl px-4 py-12 sm:px-6 sm:py-16">
		<SectionHeading title="아지트" subtitle="떠오른 생각을 짧게 남기는 곳입니다." />

		{
			isAdmin && (
				<a
					href="/admin/notes/"
					class="mb-8 inline-block rounded-xl bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-violet-700"
				>
					새 글 쓰기
				</a>
			)
		}

		{notes.length === 0 && <p class="text-sm text-zinc-500">아직 남긴 글이 없습니다.</p>}

		<ul class="space-y-4">
			{
				notes.map((n) => (
					<li class="rounded-2xl border border-zinc-200/90 bg-white p-5 shadow-sm dark:border-zinc-800/90 dark:bg-zinc-900/40">
						<div class="flex items-center justify-between gap-2 text-xs text-zinc-500">
							<time datetime={n.createdAt.toISOString()}>{formatDateTime(n.createdAt)}</time>
							{!n.isPublic && (
								<span class="rounded-md bg-zinc-200 px-2 py-0.5 font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
									비공개
								</span>
							)}
						</div>
						<p class="mt-3 text-base leading-relaxed whitespace-pre-wrap text-zinc-800 dark:text-zinc-200">{n.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>
