---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/home/SectionHeading.astro';
import VideoCard from '../../components/youtube/VideoCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('videos')).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout
	title="YouTube 인덱스 — 조동이형"
	description="유튜브 영상을 최신순으로 모았습니다."
>
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
		<SectionHeading title="YouTube Index" subtitle="올린 영상을 최신순으로 모았습니다." />
		<ul class="mt-14 space-y-5">
			{
				entries.map((e) => (
					<li>
						<VideoCard
							title={e.data.title}
							url={e.data.url}
							thumbnailUrl={e.data.thumbnailUrl}
							publishedAt={e.data.publishedAt}
							tags={e.data.tags}
							layout="horizontal"
						/>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>
