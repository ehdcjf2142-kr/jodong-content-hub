---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/home/SectionHeading.astro';
import Tag from '../../components/ui/Tag.astro';
import { getAllFeedItems } from '../../lib/content';
import type { FeedItem } from '../../lib/types';

const items = await getAllFeedItems();

function platformOf(item: FeedItem): 'youtube' | 'tistory' | 'naver' {
	return item.kind === 'youtube' ? 'youtube' : (item.platform ?? 'tistory');
}

const platformLabel = { youtube: 'YouTube', tistory: 'Tistory', naver: 'Naver' } as const;

const monthFormat = new Intl.DateTimeFormat('ko-KR', { timeZone: 'Asia/Seoul', year: 'numeric', month: 'long' });
const dayFormat = new Intl.DateTimeFormat('ko-KR', { timeZone: 'Asia/Seoul', month: 'numeric', day: 'numeric' });

// 이미 최신순으로 정렬되어 있으니 순서대로 월별로 묶습니다.
const groups: { month: string; items: FeedItem[] }[] = [];
for (const item of items) {
	const month = monthFormat.format(item.publishedAt);
	const last = groups[groups.length - 1];
	if (last && last.month === month) last.items.push(item);
	else groups.push({ month, items: [item] });
}
---

<BaseLayout title="Log — 조동이형" description="유튜브·티스토리·네이버에 언제 어떤 글을 올렸는지 모아 둔 기록.">
	<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<SectionHeading title="Social Log" subtitle="어디에 어떤 글을 언제 올렸는지, 자동으로 쌓이는 기록입니다." />

		{
			groups.map((g) => (
				<section class="mt-10 first:mt-0">
					<h3 class="text-sm font-semibold tracking-wide text-zinc-500 dark:text-zinc-400">{g.month}</h3>
					<ul class="mt-3 divide-y divide-zinc-200 border-y border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
						{g.items.map((item) => (
							<li>
								<a
									href={item.url}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center gap-3 py-3 transition hover:bg-zinc-100/70 dark:hover:bg-zinc-900/50"
								>
									<span class="w-12 shrink-0 text-xs text-zinc-500 tabular-nums">{dayFormat.format(item.publishedAt)}</span>
									<span class="shrink-0">
										<Tag label={platformLabel[platformOf(item)]} variant={platformOf(item)} />
									</span>
									<span class="min-w-0 truncate text-sm text-zinc-900 dark:text-zinc-100">{item.title}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</BaseLayout>
