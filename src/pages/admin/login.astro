---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

if (Astro.locals.isAdmin) return Astro.redirect('/admin/');

const error = Astro.url.searchParams.get('error');
const messages: Record<string, string> = {
	denied: '이 구글 계정은 글쓰기 권한이 없습니다. 내 계정으로 다시 시도하세요.',
	state: '로그인 확인에 실패했습니다. 다시 시도하세요.',
	token: '구글과 연결하는 중 문제가 생겼습니다. 다시 시도하세요.',
};
---

<BaseLayout title="로그인 — 조동이형" noindex>
	<div class="mx-auto max-w-md px-4 py-16 sm:px-6">
		<h1 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">아지트 로그인</h1>
		<p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">글쓰기는 주인만 할 수 있어요.</p>
		{
			error && (
				<p class="mt-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-950/40 dark:text-red-200">
					{messages[error] ?? '로그인에 실패했습니다.'}
				</p>
			)
		}
		<a
			href="/api/auth/login"
			class="mt-8 flex w-full items-center justify-center rounded-xl bg-violet-600 px-4 py-3 text-base font-semibold text-white transition hover:bg-violet-700"
		>
			구글로 로그인
		</a>
	</div>
</BaseLayout>
