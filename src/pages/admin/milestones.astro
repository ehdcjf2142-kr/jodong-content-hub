---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	addMilestone,
	deleteMilestone,
	listMilestones,
	moveMilestone,
	updateMilestone,
	type Milestone,
} from '../../lib/milestones';

export const prerender = false;

let error = '';

if (Astro.request.method === 'POST') {
	try {
		const form = await Astro.request.formData();
		const action = String(form.get('action') ?? '');
		const id = Number(form.get('id'));
		const year = String(form.get('year') ?? '').trim();
		const title = String(form.get('title') ?? '').trim();
		const body = String(form.get('body') ?? '').trim();

		if (action === 'add' || action === 'save') {
			if (!year || !title) {
				error = '연도와 제목은 꼭 입력해야 합니다.';
			} else if (action === 'add') {
				await addMilestone(year, title, body);
			} else {
				await updateMilestone(id, year, title, body);
			}
		} else if (action === 'delete') {
			await deleteMilestone(id);
		} else if (action === 'up' || action === 'down') {
			await moveMilestone(id, action === 'up' ? -1 : 1);
		}
		if (!error) return Astro.redirect('/admin/milestones/', 303);
	} catch (e) {
		console.error(e);
		error = '저장에 실패했습니다. 데이터베이스 설정을 확인하세요.';
	}
}

let items: Milestone[] = [];
try {
	items = await listMilestones();
} catch (e) {
	console.error(e);
	error ||= '마일스톤을 불러오지 못했습니다. 데이터베이스 설정을 확인하세요.';
}

const input =
	'w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-base text-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100';
const btn =
	'rounded-lg border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800';
---

<BaseLayout title="마일스톤 수정 — 조동이형" noindex>
	<div class="mx-auto max-w-2xl px-4 py-10 sm:px-6">
		<a href="/admin/" class="text-sm text-zinc-500 hover:underline">← 관리 홈</a>
		<h1 class="mt-2 text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">마일스톤 수정</h1>

		{
			error && (
				<p class="mt-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-950/40 dark:text-red-200">
					{error}
				</p>
			)
		}

		<form method="post" class="mt-8 space-y-3 rounded-2xl border border-violet-200 bg-violet-50/50 p-5 dark:border-violet-900/50 dark:bg-violet-950/20">
			<input type="hidden" name="action" value="add" />
			<h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-50">새 마일스톤 추가</h2>
			<input name="year" placeholder="연도 (예: 2024)" required class={input} />
			<input name="title" placeholder="제목" required class={input} />
			<textarea name="body" rows="3" placeholder="한 줄 설명" class={input}></textarea>
			<button type="submit" class="w-full rounded-xl bg-violet-600 px-4 py-3 font-semibold text-white hover:bg-violet-700">
				추가
			</button>
		</form>

		<ul class="mt-10 space-y-4">
			{
				items.map((m) => (
					<li>
						<form method="post" class="space-y-3 rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/40">
							<input type="hidden" name="id" value={m.id} />
							<input name="year" value={m.year} required class={input} />
							<input name="title" value={m.title} required class={input} />
							<textarea name="body" rows="3" class={input}>{m.body}</textarea>
							<div class="flex flex-wrap gap-2">
								<button type="submit" name="action" value="save" class="rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-700">
									저장
								</button>
								<button type="submit" name="action" value="up" formnovalidate class={btn}>↑ 위로</button>
								<button type="submit" name="action" value="down" formnovalidate class={btn}>↓ 아래로</button>
								<button
									type="submit"
									name="action"
									value="delete"
									formnovalidate
									class="ml-auto rounded-lg border border-red-300 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950/40"
									onclick="return confirm('삭제할까요?')"
								>
									삭제
								</button>
							</div>
						</form>
					</li>
				))
			}
		</ul>
		{items.length === 0 && !error && <p class="mt-8 text-sm text-zinc-500">아직 마일스톤이 없습니다. 위에서 추가하세요.</p>}
	</div>
</BaseLayout>
