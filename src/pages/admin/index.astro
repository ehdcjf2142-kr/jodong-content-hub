---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const links = [
	{ href: '/admin/notes/', label: '짧은 글 쓰기', desc: '푸념, 생각, 메모를 남깁니다.' },
	{ href: '/admin/milestones/', label: '마일스톤 수정', desc: 'About 페이지의 인생 패치노트를 고칩니다.' },
];
---

<BaseLayout title="관리 — 조동이형" noindex>
	<div class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
		<h1 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">아지트 관리</h1>
		<ul class="mt-8 space-y-3">
			{
				links.map((l) => (
					<li>
						<a
							href={l.href}
							class="block rounded-2xl border border-zinc-200/90 bg-white p-5 shadow-sm transition hover:border-violet-300/80 dark:border-zinc-800/90 dark:bg-zinc-900/40"
						>
							<span class="text-base font-semibold text-zinc-900 dark:text-zinc-50">{l.label}</span>
							<span class="mt-1 block text-sm text-zinc-600 dark:text-zinc-400">{l.desc}</span>
						</a>
					</li>
				))
			}
		</ul>
		<form method="post" action="/api/auth/logout" class="mt-10">
			<button type="submit" class="text-sm text-zinc-500 underline hover:text-zinc-800 dark:hover:text-zinc-200">
				로그아웃
			</button>
		</form>
	</div>
</BaseLayout>
